# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
SESSION_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-fernet-key-32-urlsafe-base64
# Custom URL scheme the iOS shell registers. The Drive/YouTube-connect OAuth
# callback redirects to "<scheme>://channels/youtube/connected" when ?platform=ios.
IOS_REDIRECT_SCHEME=autoedit

# Web frontend (apps/web): leave NEXT_PUBLIC_API_URL empty so the browser calls
# the API same-origin (/api/*, /health) and Next proxies to API_PROXY_ORIGIN.
NEXT_PUBLIC_API_URL=
API_PROXY_ORIGIN=http://localhost:8000
# Same Supabase project as SUPABASE_URL below, baked into the web build
# (docker-compose passes these through from the vars above).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database - Supabase connection pooler, session mode (port 5432, not 6543 -
# keeps session-level SET statement_timeout working). Use the pooler, not the
# direct db.<ref>.supabase.co host - that one is IPv6-only and commonly
# unreachable (e.g. from Docker Desktop on Windows).
# Project Settings > Database > Connection string > Session pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth: system of record for login/signup. The backend only ever
# verifies the JWTs Supabase issues client-side, against this project's own
# JWKS endpoint (https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://<project-ref>.supabase.co

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4

# Google OAuth - Drive/YouTube data-access consent only (login itself is
# Supabase's Google provider, configured in the Supabase dashboard).
# Enable YouTube Data API v3 on this OAuth project.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Points at the API's own callback route (not the web app) - in a
# single-origin deploy this is https://<api-domain>/api/channels/youtube/callback.
# Also add autoedit://channels/youtube/connected to the OAuth client's
# authorized redirect URIs for the iOS shell.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/channels/youtube/callback

# AI providers
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# B-roll
# Pexels is now used for VIDEO b-roll only.
PEXELS_API_KEY=

# Dense per-phrase web-image B-roll. When ENABLE_DENSE_BROLL=true and an Apify
# token is set, almost every spoken phrase gets a literal, GPT-planned image
# pulled from Google Images via an Apify Actor, ranked by the Jina reranker.
# Set ENABLE_DENSE_BROLL=false to fall back to the old sparse Pexels behaviour.
ENABLE_DENSE_BROLL=true
APIFY_API_TOKEN=
APIFY_IMAGE_ACTOR=hooli~google-images-scraper
APIFY_RESULTS_PER_QUERY=15
APIFY_TIMEOUT_SECONDS=180
BROLL_QUERY_MODEL=gpt-4o

# Jina reranker (multimodal image ranking layer between B-roll search
# and final image selection). OFF by default; when disabled the pipeline is
# byte-identical to before. Falls back to the existing selection on any failure.
ENABLE_JINA_RERANKER=false
JINA_API_KEY=
JINA_MODEL=jina-reranker-m0
JINA_MAX_CANDIDATES=30
JINA_TIMEOUT_SECONDS=25

# Storage
STORAGE_DIR=./storage
ASSETS_DIR=./assets

# "local" (default) keeps every media file on STORAGE_DIR - nothing else below
# needs to be set for local dev. "r2" uploads to Cloudflare R2 instead, so the
# API and worker no longer need a shared disk (see services/autoedit/object_storage.py).
STORAGE_BACKEND=local
# R2_BUCKET=
# R2_ENDPOINT=            # https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Final-render ffmpeg thread cap (decoder + filtergraph + encoder).
# 1 keeps peak RAM low so memory-limited containers don't OOM-kill the render
# (SIGKILL 9). Bump to 2-4 on hosts with plenty of memory for faster renders.
RENDER_FFMPEG_THREADS=1

# SFX engine
SFX_DEBUG=false
# Leave empty to allow unverified licenses only in development.
# SFX_ALLOW_UNVERIFIED_LICENSES=true
