# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
SESSION_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-fernet-key-32-urlsafe-base64

# Database
DATABASE_URL=postgresql://autoedit:autoedit@localhost:5432/autoedit

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4

# Google OAuth (Drive readonly + YouTube upload + sign-in)
# Enable YouTube Data API v3 on this OAuth project, then Reconnect Google.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# AI providers
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# B-roll
PEXELS_API_KEY=

# Jina reranker (optional multimodal image ranking layer between B-roll search
# and final image selection). OFF by default; when disabled the pipeline is
# byte-identical to before. Falls back to the existing selection on any failure.
ENABLE_JINA_RERANKER=false
JINA_API_KEY=
JINA_MODEL=jina-reranker-m0
JINA_MAX_CANDIDATES=30
JINA_TIMEOUT_SECONDS=10

# Storage
STORAGE_DIR=./storage
ASSETS_DIR=./assets

# Final-render ffmpeg thread cap (decoder + filtergraph + encoder).
# 1 keeps peak RAM low so memory-limited containers don't OOM-kill the render
# (SIGKILL 9). Bump to 2-4 on hosts with plenty of memory for faster renders.
RENDER_FFMPEG_THREADS=1

# SFX engine
SFX_DEBUG=false
# Leave empty to allow unverified licenses only in development.
# SFX_ALLOW_UNVERIFIED_LICENSES=true
